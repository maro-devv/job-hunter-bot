{
  "name": "Job Hunter Bot",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const noise = /^(this company is actively hiring|actively (hiring|recruiting)|apply with resume|easy apply|your job alert|see all jobs|manage your)/i;\nconst jobs = [];\n\nfor (const item of $input.all()) {\n  const text = item.json.text || '';\n  const html = item.json.html || '';\n  const date = item.json.date;\n  const lines = text.split('\\n').map(l => l.trim());\n\n  const getArea = (id, location) => {\n    if (/alexandria|الإسكندرية/i.test(location)) return 'Alexandria';\n    const start = html.indexOf('jobs/view/' + id);\n    if (start === -1) return 'Other';\n    const re = /jobs\\/view\\/(\\d+)/g;\n    re.lastIndex = start;\n    let end = html.length;\n    let m2;\n    while ((m2 = re.exec(html)) !== null) {\n      if (m2[1] !== id) { end = m2.index; break; }\n    }\n    return /\\(Remote\\)/i.test(html.slice(start, end)) ? 'Remote' : 'Other';\n  };\n\n  for (let i = 0; i < lines.length; i++) {\n    const m = lines[i].match(/^View job:.*\\/jobs\\/view\\/(\\d+)/);\n    if (!m) continue;\n\n    const card = [];\n    for (let j = i - 1; j >= 0 && card.length < 3; j--) {\n      const l = lines[j];\n      if (!l) continue;\n      if (/^View job:/.test(l) || /^-{5,}/.test(l)) break;\n      if (noise.test(l)) continue;\n      card.unshift(l);\n    }\n    if (card.length < 3) continue;\n\n    jobs.push({\n      json: {\n        title: card[0],\n        company: card[1],\n        location: card[2],\n        area: getArea(m[1], card[2]),\n        link: 'https://www.linkedin.com/jobs/view/' + m[1],\n        date: date\n      }\n    });\n  }\n}\n\nreturn jobs;"
      },
