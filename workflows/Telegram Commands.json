    {
      "parameters": {
        "jsCode": "const msg = $('Telegram Trigger').first().json.message;\nconst cmd = (msg.text || '').trim().toLowerCase();\nconst chatId = msg.chat.id;\nconst rows = $input.all().map(i => i.json).filter(r => r.title);\n\nlet wanted = null;\nif (cmd.startsWith('/remote')) wanted = 'Remote';\nelse if (cmd.startsWith('/alex')) wanted = 'Alexandria';\nelse if (!cmd.startsWith('/all')) {\n  return [{ json: { chatId, text: 'Commands: /remote  /alex  /all' } }];\n}\n\nconst list = rows\n    .filter(r => !wanted || String(r.area || '').trim().toLowerCase() === wanted.toLowerCase())\n  .slice(0, 10);\n\nif (list.length === 0) {\n  return [{ json: { chatId, text: 'No jobs found for this filter yet.' } }];\n}\n\nconst text = list\n  .map((r, i) => `${i + 1}. ${r.title} - ${r.company} (${r.location})\\n${r.link}`)\n  .join('\\n\\n');\n\nreturn [{ json: { chatId, text } }];"
      },
